    <diagram id="upload-flow" name="2. Upload &amp; API Flow">
        <mxGraphModel dx="720" dy="346" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title2" value="Sheet Upload &amp; API Gateway Flow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="400" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="u_user" value="User" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="100" y="100" width="40" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="u_ui" value="&lt;b&gt;React UI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="200" y="100" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="u_api" value="&lt;b&gt;Go API Gateway&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="400" y="100" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="u_db" value="&lt;b&gt;Cloud SQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="650" y="90" width="100" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="u_pubsub" value="&lt;b&gt;Pub/Sub&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="850" y="100" width="120" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="step1" value="1. Upload .xlsx file" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="100" y="200" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="step2" value="2. POST /api/v1/sheets/upload&lt;br&gt;   (multipart/form-data)" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="100" y="240" width="250" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="step3" value="3. Parse sheet rows:&lt;br&gt;   - Validate required columns&lt;br&gt;   - Extract: name, email, profile_url, interview_urls" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
                    <mxGeometry x="100" y="300" width="350" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step4" value="4. Batch INSERT into Cloud SQL:&lt;br&gt;   - INSERT INTO sheets (filename, row_count) ...&lt;br&gt;   - INSERT INTO candidates (sheet_id, name, urls, status=&#39;PENDING&#39;) ..." style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
                    <mxGeometry x="100" y="380" width="450" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="step5" value="5. Batch Publish to Pub/Sub:&lt;br&gt;   - Topic: candidate-processing&lt;br&gt;   - 1 message per candidate row&lt;br&gt;   - Payload: {candidateId, profileVideoUrl, interviewVideoUrls}" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
                    <mxGeometry x="100" y="460" width="450" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="step6" value="6. Return HTTP 202 Accepted:&lt;br&gt;   {&quot;sheetId&quot;: &quot;uuid&quot;, &quot;candidateCount&quot;: 1500, &quot;status&quot;: &quot;PROCESSING&quot;}" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
                    <mxGeometry x="100" y="560" width="500" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="step7" value="7. UI shows confirmation &amp; starts polling for status" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;" parent="1" vertex="1">
                    <mxGeometry x="100" y="620" width="400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sheetformat" value="&lt;b&gt;Expected Google Sheet Format:&lt;/b&gt;" style="text;html=1;fontSize=12;fillColor=none;strokeColor=none;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="700" y="220" width="250" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sheettable" value="&lt;table border=&#39;1&#39; cellpadding=&#39;4&#39; style=&#39;font-size:11px;border-collapse:collapse;&#39;&gt;&lt;tr style=&#39;background:#f0f0f0;&#39;&gt;&lt;th&gt;Name&lt;/th&gt;&lt;th&gt;Email&lt;/th&gt;&lt;th&gt;Profile Video&lt;/th&gt;&lt;th&gt;Interview Video 1&lt;/th&gt;&lt;th&gt;Interview Video 2&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;John Doe&lt;/td&gt;&lt;td&gt;john@...&lt;/td&gt;&lt;td&gt;https://...&lt;/td&gt;&lt;td&gt;https://...&lt;/td&gt;&lt;td&gt;https://...&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Jane Smith&lt;/td&gt;&lt;td&gt;jane@...&lt;/td&gt;&lt;td&gt;https://...&lt;/td&gt;&lt;td&gt;https://...&lt;/td&gt;&lt;td&gt;https://...&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="700" y="260" width="500" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

                <mxCell id="payload3" value="&lt;b&gt;verification-complete:&lt;/b&gt;&lt;br&gt;{&lt;br&gt;  &quot;candidateId&quot;: &quot;uuid&quot;,&lt;br&gt;  &quot;result&quot;: &quot;MATCH&quot;,&lt;br&gt;  &quot;confidence&quot;: 0.94,&lt;br&gt;  &quot;details&quot;: [...]&lt;br&gt;}" style="text;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="770" y="640" width="280" height="130" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="encoding-service" name="4. Encoding Service (Python)">
        <mxGraphModel dx="1320" dy="795" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title4" value="Python Encoding Service - Internal Flow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="450" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="enc_input" value="&lt;b&gt;Pub/Sub Message&lt;/b&gt;&lt;br&gt;{candidateId, videoUrls}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="120" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="enc_download" value="&lt;b&gt;1. Download Videos&lt;/b&gt;&lt;br&gt;&lt;br&gt;• HTTP GET from URLs&lt;br&gt;• Save to /tmp&lt;br&gt;• Retry 3x on failure&lt;br&gt;• Validate video format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="240" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="enc_frames" value="&lt;b&gt;2. Extract Frames&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Sample every 30th frame&lt;br&gt;• Or scene-change detect&lt;br&gt;• Target: 10-20 frames/video&lt;br&gt;• Use OpenCV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="340" y="240" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="enc_detect" value="&lt;b&gt;3. Face Detection&lt;/b&gt;&lt;br&gt;&lt;br&gt;• MTCNN / RetinaFace&lt;br&gt;• Crop &amp; align faces&lt;br&gt;• Handle: no face found&lt;br&gt;• Handle: multiple faces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="240" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="enc_embed" value="&lt;b&gt;4. Generate Embeddings&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ArcFace / InsightFace&lt;br&gt;• 512-dim vector per face&lt;br&gt;• Compute mean per video&lt;br&gt;• GPU accelerated (T4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="860" y="240" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="enc_store" value="&lt;b&gt;5. Store in GCS&lt;/b&gt;&lt;br&gt;&lt;br&gt;gs://encodings-bucket/&lt;br&gt;  {candidateId}/&lt;br&gt;    profile_encoding.npy&lt;br&gt;    interview_0.npy&lt;br&gt;    interview_1.npy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="440" width="200" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="enc_updatedb" value="&lt;b&gt;6. Update DB&lt;/b&gt;&lt;br&gt;status = ENCODING_COMPLETE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="340" y="460" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="enc_publish" value="&lt;b&gt;7. Publish&lt;/b&gt;&lt;br&gt;Topic: encoding-complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="460" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="enc_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="enc_input" target="enc_download" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="enc_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="enc_download" target="enc_frames" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="enc_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="enc_frames" target="enc_detect" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="enc_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="enc_detect" target="enc_embed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="enc_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="860" y="300" as="sourcePoint"/>
                        <mxPoint x="700" y="440" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="860" y="380"/>
                            <mxPoint x="700" y="380"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="enc_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="enc_store" target="enc_updatedb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="enc_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="enc_updatedb" target="enc_publish" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="enc_scale" value="&lt;b&gt;Scaling Strategy:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• GKE with GPU node pool (NVIDIA T4)&lt;br&gt;• Cluster Autoscaler: 0 → 20 nodes&lt;br&gt;• HPA on Pub/Sub backlog metric&lt;br&gt;• 1 candidate per pod (GPU memory)&lt;br&gt;• Preemptible VMs for cost savings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="860" y="440" width="250" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="enc_errors" value="&lt;b&gt;Error Handling:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Video download fails → retry 3x → ERROR&lt;br&gt;• No face detected → status ERROR&lt;br&gt;• Corrupt video → skip, mark ERROR&lt;br&gt;• Timeout (10min) → nack, retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="860" y="600" width="250" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="verification-service" name="5. Verification Service (Python)">
        <mxGraphModel dx="1320" dy="795" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title5" value="Python Verification Service - Face Matching Logic" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="v_input" value="&lt;b&gt;Input: encoding-complete message&lt;/b&gt;&lt;br&gt;{candidateId, encodingPaths}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="100" y="100" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="v_load" value="&lt;b&gt;1. Load Encodings from GCS&lt;/b&gt;&lt;br&gt;&lt;br&gt;• profile_encoding.npy&lt;br&gt;• interview_0_encoding.npy&lt;br&gt;• interview_1_encoding.npy&lt;br&gt;• ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="200" width="250" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="v_compare1" value="&lt;b&gt;2. Compare: Profile vs Each Interview&lt;/b&gt;&lt;br&gt;&lt;br&gt;cosine_similarity(profile_vec, interview_vec)&lt;br&gt;&lt;br&gt;Threshold: &amp;gt; 0.6 = MATCH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="370" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v_compare2" value="&lt;b&gt;3. Cross-Compare Interviews&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ensure interview_0 ≈ interview_1 ≈ interview_2&lt;br&gt;(all interviews should be same person)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="520" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="v_decision" value="&lt;b&gt;4. Determine Result&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="550" y="300" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v_match" value="&lt;b&gt;MATCH&lt;/b&gt;&lt;br&gt;All similarities &amp;gt; 0.6&lt;br&gt;Same person confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="960" y="190" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="v_mismatch" value="&lt;b&gt;MISMATCH&lt;/b&gt;&lt;br&gt;One or more &amp;lt; 0.4&lt;br&gt;Different person detected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="960" y="310" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="v_inconclusive" value="&lt;b&gt;INCONCLUSIVE&lt;/b&gt;&lt;br&gt;Between 0.4 and 0.6&lt;br&gt;Manual review needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="830" y="415" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="v_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_input" target="v_load" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_load" target="v_compare1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_compare1" target="v_compare2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_compare1" target="v_decision" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_decision" target="v_match" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_decision" target="v_mismatch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_decision" target="v_inconclusive" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_output" value="&lt;b&gt;5. Update DB &amp; Publish&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Update candidates.status&lt;br&gt;• Store verification_result JSONB&lt;br&gt;• Publish to verification-complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="550" y="515" width="250" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" parent="1" source="v_compare2" target="v_output" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v_matrix" value="&lt;b&gt;Example Similarity Matrix:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&#39;1&#39; cellpadding=&#39;3&#39; style=&#39;font-size:10px;border-collapse:collapse;&#39;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Profile&lt;/th&gt;&lt;th&gt;Int.1&lt;/th&gt;&lt;th&gt;Int.2&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Profile&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;0.92&lt;/td&gt;&lt;td&gt;0.88&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Int.1&lt;/td&gt;&lt;td&gt;0.92&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;td&gt;0.95&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Int.2&lt;/td&gt;&lt;td&gt;0.88&lt;/td&gt;&lt;td&gt;0.95&lt;/td&gt;&lt;td&gt;1.00&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Result: MATCH ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="820" y="530" width="250" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
